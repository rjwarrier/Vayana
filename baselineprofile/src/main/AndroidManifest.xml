<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Hands the sample book to Vayana as another app would ("open with"), so the journey can profile the reader.
             Exported so it can also be opened from adb while debugging the journey; it only serves that sample. -->
        <provider
            android:name=".SampleBookProvider"
            android:authorities="com.vayana.baselineprofile.books"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
