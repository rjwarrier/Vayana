<?xml version="1.0" encoding="utf-8"?>
<!--
    The ONLY hardcoded color literals in the app. android:theme (pre-Compose window background,
    read before the first Compose frame) is entirely outside the Compose token system in
    core:designsystem, so it can't reference Palette.kt — this file is the equivalent single
    source of truth at the XML layer. Values are Palette.Cream100 (light) / Palette.Navy800
    (dark), kept in sync by hand; see docs/DECISIONS.md.
-->
<resources>
    <color name="window_background_light">#F5F0E8</color>
    <color name="window_background_dark">#131C27</color>
</resources>
