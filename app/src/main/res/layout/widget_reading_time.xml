<?xml version="1.0" encoding="utf-8"?>
<!--
    Responsive reading-time widget. RemoteViews cannot use Compose, so the updater applies the app's resolved M3
    colours and size class at render time. The bitmap background preserves adaptive/custom corners on every Android
    version; the chart (grid, axis, line, day labels) is one bitmap drawn for the widget's real size.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/reading_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:id="@+id/reading_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/reading_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reading_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_reading_preview_today"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="27sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reading_average_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reading_average_rule"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="7dp"
                        android:background="@color/widget_tertiary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/reading_average_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:maxLines="1"
                        android:text="@string/widget_reading_avg_label"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/reading_average"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/widget_reading_preview_average"
                        android:textColor="@color/widget_tertiary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/reading_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_reading_title"
            android:scaleType="fitXY"
            android:src="@drawable/widget_reading_preview_chart" />
    </LinearLayout>
</FrameLayout>
