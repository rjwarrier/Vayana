<?xml version="1.0" encoding="utf-8"?>
<!--
    Overview home-screen widget: the book being read, today's reading / streak / finished-books stats, and the last
    week as a chart - the things Vayana already shows elsewhere, together on one card. Same shared corner shapes and
    theme colours as the other widgets, styled on the same configure screen. RemoteViews-safe views only.
    The sample texts are what the widget picker's preview shows; the app replaces them when it draws the widget.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/overview_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <ImageView
        android:id="@+id/overview_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_border" />

    <LinearLayout
        android:id="@+id/overview_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <!-- The book being read: a small cover, title and author, and its percent as a pill. Tapping it opens the book. -->
        <LinearLayout
            android:id="@+id/overview_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/overview_cover"
                android:layout_width="40dp"
                android:layout_height="60dp"
                android:background="@drawable/widget_cover_background"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_book" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_preview_title"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/overview_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_preview_author"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/overview_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_chip"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/widget_preview_progress"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- No book being read yet: shown instead of overview_book. -->
        <LinearLayout
            android:id="@+id/overview_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/overview_empty_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_icon_background"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_widget_book" />

            <TextView
                android:id="@+id/overview_empty_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="@string/widget_empty"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Today's minutes, the current streak and books finished, divided into three equal columns. -->
        <LinearLayout
            android:id="@+id/overview_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overview_today_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_reading_preview_today"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overview_today_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_reading_today"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/overview_divider_1"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.4"
                android:background="@color/widget_on_surface_variant"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overview_streak_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_overview_preview_streak"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overview_streak_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/statistics_streak_title"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/overview_divider_2"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.4"
                android:background="@color/widget_on_surface_variant"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overview_finished_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_overview_preview_finished"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overview_finished_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/widget_overview_finished_label"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/overview_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_overview_title"
            android:scaleType="fitXY"
            android:src="@drawable/widget_reading_preview_chart" />
    </LinearLayout>
</FrameLayout>
