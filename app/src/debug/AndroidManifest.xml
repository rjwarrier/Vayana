<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only: lets Vayana see the baseline-profile test app's sample-book provider, so the profile
         journey can open a book through "open with" (see docs/BASELINE_PROFILE.md). Release builds never have it. -->
    <queries>
        <provider android:authorities="com.vayana.baselineprofile.books" />
    </queries>

    <application>
        <!-- Debug builds only: the text recognition spike (docs/SCANNED_PDF_TEXT_PLAN.md, phase 1). DUMP limits it to
             adb's shell; no app can send it. -->
        <receiver
            android:name="com.vayana.app.debug.OcrSpikeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
